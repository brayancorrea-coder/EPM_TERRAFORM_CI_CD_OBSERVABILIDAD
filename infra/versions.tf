terraform {
  # >= 1.11 por el bloqueo nativo del estado en S3 (use_lockfile), sin DynamoDB
  required_version = ">= 1.11.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }
}
